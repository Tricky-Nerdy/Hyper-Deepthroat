# Original game binary and the decompiler's export (not needed to run: the converted assets in game/assets/sdt are
# included; regenerate them with tools/swfconv, see README)
/original/
/extracted/

# Godot
.godot/
*.import

# Tool environments
/tools/.venv/
__pycache__/
*.pyc

# Local Claude settings
/.claude/settings.local.json

# Native extension build outputs (build with scons in native/, see native/README.md)
/native/src/*.o
/native/src/*.os
/native/.sconsign*.dblite
/game/bin/*.dll
!/game/bin/sdt_native.windows.template_debug.x86_64.dll
!/game/bin/sdt_native.windows.template_release.x86_64.dll
/game/bin/*.a
/game/bin/*.so

# Mods folder used when running from the repo (Flash.mods_dir)
/Mods/

# Local, machine-specific files and private working notes
/notes/
/user/
/run_debug.local.bat

# Reproducible neutral-workbench outputs and Apple native build products
/build/
/game/bin/*.dylib
/game/bin/*.framework/
/game/bin/*.xcframework/
/game/export_credentials.cfg
