#!/usr/bin/env python
# Builds the SDT native extension (game/bin/sdt_native.*) against godot-cpp.
#   scons platform=windows use_mingw=yes target=template_debug      (development: editor / debug runs)
#   scons platform=windows use_mingw=yes target=template_release    (exported builds)
# The Godot API is taken from extension_api.json, dumped from the engine binary the game uses
# (godot --headless --dump-extension-api).
import os

ARGUMENTS.setdefault("custom_api_file", os.path.abspath("extension_api.json"))
ARGUMENTS.setdefault("build_profile", os.path.abspath("build_profile.json"))
env = SConscript("godot-cpp/SConstruct")
# Keep filenames consistent across platforms (Unix would otherwise add a "lib" prefix).
env["SHLIBPREFIX"] = ""
env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")
library = env.SharedLibrary("../game/bin/sdt_native{}{}".format(env["suffix"], env["SHLIBSUFFIX"]), source=sources)
env.NoCache(library)
Default(library)
