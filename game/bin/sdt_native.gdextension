[configuration]

entry_symbol = "sdt_native_init"
compatibility_minimum = "4.7"

[libraries]

windows.debug.x86_64 = "res://bin/sdt_native.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/sdt_native.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/sdt_native.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/sdt_native.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/sdt_native.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/sdt_native.linux.template_release.arm64.so"
macos.debug = "res://bin/sdt_native.macos.template_debug.universal.dylib"
macos.release = "res://bin/sdt_native.macos.template_release.universal.dylib"
android.debug.arm64 = "res://bin/sdt_native.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/sdt_native.android.template_release.arm64.so"
