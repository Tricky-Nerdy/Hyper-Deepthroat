; Engine configuration file.
config_version=5

[application]

config/name="SDT Godot"
config/description="Godot port of SDT v1.21.1b"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Flash="*res://flash/flash_runtime.gd"
g="*res://src/g.gd"

[display]

window/size/viewport_width=700
window/size/viewport_height=600
window/size/window_width_override=1050
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/vsync/vsync_mode=0

[importer_defaults]

texture={
"mipmaps/generate": true
}

[physics]

common/physics_ticks_per_second=30
common/max_physics_steps_per_frame=4
common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_2d=2
textures/canvas_textures/default_texture_filter=2
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
